--cpu Cortex-M3
"stp23\startup_stm32f103xb.o"
"stp23\main.o"
"stp23\gpio.o"
"stp23\tim.o"
"stp23\usart.o"
"stp23\stm32f1xx_it.o"
"stp23\stm32f1xx_hal_msp.o"
"stp23\stm32f1xx_hal_gpio_ex.o"
"stp23\stm32f1xx_hal_tim.o"
"stp23\stm32f1xx_hal_tim_ex.o"
"stp23\stm32f1xx_hal.o"
"stp23\stm32f1xx_hal_rcc.o"
"stp23\stm32f1xx_hal_rcc_ex.o"
"stp23\stm32f1xx_hal_gpio.o"
"stp23\stm32f1xx_hal_dma.o"
"stp23\stm32f1xx_hal_cortex.o"
"stp23\stm32f1xx_hal_pwr.o"
"stp23\stm32f1xx_hal_flash.o"
"stp23\stm32f1xx_hal_flash_ex.o"
